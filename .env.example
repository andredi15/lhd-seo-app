HOST=127.0.0.1
PORT=3000
# Optional. Without both values, the complete deterministic report still works.
OPENAI_API_KEY=
# Use a Responses API model supporting Structured Outputs available to your account.
OPENAI_MODEL=
# Optional server-side password for all routes; Basic Auth username is lighthouse.
# Required when HOST is not a loopback address. Use TLS on a reverse proxy remotely.
APP_PASSWORD=
CRAWL_TIMEOUT_MS=15000
MAX_HTML_BYTES=3000000

# Optional Google PageSpeed Insights API key. Enable the API in Google Cloud.
PAGESPEED_API_KEY=

# Optional manual Google organic ranking checks. Kept server-side.
SEARCHAPI_API_KEY=

# Optional alternate Chrome/Edge executable for PDF generation. Default: installed Edge.
PDF_BROWSER_PATH=

# Public /audit interface: global scan cap per UTC day, in this server process.
PUBLIC_DAILY_SCAN_LIMIT=20
# Replace with your actual consultation/booking page when available.
PUBLIC_BOOKING_URL=https://lighthousedigitalhq.com/contact/
# Set true on the public host so its root URL opens the simplified audit.
PUBLIC_SITE_MODE=false
# Optional transactional delivery for public reports. When both are set, email becomes required and browser PDF access is disabled.
RESEND_API_KEY=
PUBLIC_REPORT_FROM_EMAIL="Lighthouse Digital <reports@example.com>"
# Optional Reply-To address for report emails.
PUBLIC_REPORT_REPLY_TO=
# Optional booking link shown in report emails.
PUBLIC_REPORT_BOOKING_URL=https://go.lighthousedigitalhq.com/widget/booking/akGkMgpqzmEW7O7LkuHW
# Optional 1-3 known reverse-proxy hops. Leave blank for direct local access.
TRUST_PROXY_HOPS=
